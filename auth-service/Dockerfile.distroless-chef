# Chef stage - install cargo-chef
FROM rust:1 AS chef
WORKDIR /app
RUN cargo install cargo-chef

# Planner stage - generate recipe for dependencies
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Builder stage - build dependencies then application
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --recipe-path recipe.json
# Build application
#

COPY . .
RUN cargo build --release

# Runtime stage - Google's distroless image
# "cc" variant includes libc for dynamically-linked binaries
FROM gcr.io/distroless/cc-debian12 as runtime
WORKDIR /app
# Copy the binary
COPY --from=builder /app/target/release/auth-service /app/auth-service
# Copy assets folder needed by the application
COPY --from=builder /app/assets /app/assets
ENTRYPOINT ["/app/auth-service"]
